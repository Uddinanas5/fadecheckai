{
  "expo": {
    "name": "FadeCheck",
    "slug": "fadecheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Fadecheckailogo.png",
    "scheme": "fadecheck",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/Fadecheckailogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fadecheck.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FadeCheck needs camera access to analyze your haircut and provide personalized grooming tips",
        "NSPhotoLibraryUsageDescription": "FadeCheck needs photo library access to analyze photos of your haircut",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.215893084176-mc7oivucn5877aamkmfpe0ac2t6bho5q"
            ]
          }
        ]
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Fadecheckailogo.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.fadecheck.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Fadecheckailogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FadeCheck needs camera access to analyze your haircut and provide personalized grooming tips"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FadeCheck needs photo library access to select photos"
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60dfae44-c004-4729-b7c2-d20f66758a9a"
      }
    },
    "owner": "uddinanas5"
  }
}
