{
  "expo": {
    "name": "FadeCheck",
    "slug": "fadecheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Fadecheckailogo.png",
    "scheme": "fadecheck",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/Fadecheckailogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fadecheck.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FadeCheck needs camera access to rate your haircut",
        "NSPhotoLibraryUsageDescription": "FadeCheck needs photo library access to select photos of your haircut"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Fadecheckailogo.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.fadecheck.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Fadecheckailogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FadeCheck needs camera access to rate your haircut"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FadeCheck needs photo library access to select photos"
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
