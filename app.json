{
  "expo": {
    "name": "FadeCheck",
    "slug": "fadecheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fadecheck",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fadecheck.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FadeCheck needs camera access to rate your haircut",
        "NSPhotoLibraryUsageDescription": "FadeCheck needs photo library access to select photos of your haircut"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.fadecheck.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FadeCheck needs camera access to rate your haircut"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FadeCheck needs photo library access to select photos"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
